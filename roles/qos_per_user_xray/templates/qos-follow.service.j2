[Unit]
Description=VFF per-user QoS follow Xray access log (conntrack mark + tc)
Wants=network-online.target
After=network-online.target qos-bootstrap.service{% if qos_log_source == 'docker' %} docker.service{% elif qos_xray_systemd_unit | default('') | length > 0 %} {{ qos_xray_systemd_unit }}{% endif %}
Requires=qos-bootstrap.service

[Service]
Type=simple
EnvironmentFile=/etc/vff-qos/qos.env
Environment=ENV_FILE=/etc/vff-qos/qos.env
ExecStart=/usr/local/bin/qos_follow_xray_email.sh
Restart=always
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
